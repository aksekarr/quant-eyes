    {
      "id": "next",
      "sentences": [
        {
          "claims": [
            "next.correlation"
          ],
          "text": "Its correlation with the tracker was 0.53, measured on monthly returns in pounds from the end of Jan 2010 to the end of Sep 2026: 1 would mean always moving in step, 0 no pattern, and −1 always opposite."
        },
        {
          "claims": [
            "next.rolling_lowest",
            "next.rolling_highest"
          ],
          "text": "Measured over each 36-month stretch, it ranged from 0.07 (the 36 months to the end of May 2015) to 0.79 (the 36 months to the end of Jun 2019)."
        },
        {
          "claims": [],
          "text": "Correlation says how consistently the monthly moves lined up, not how big they were. A low figure is not protection."
        },
        {
          "claims": [
            "next.mix_annualised",
            "next.tracker_annualised"
          ],
          "text": "As an illustration, not a recommendation: from the end of Jan 2010 to the end of Sep 2026, a mix of 90% in the tracker and 10% in this investment, reset to 90/10 at the end of every December, returned 13.6% a year, against 12.5% a year for the tracker alone."
        },
        {
          "claims": [
            "next.mix_volatility",
            "next.tracker_volatility",
            "next.mix_fall",
            "next.tracker_fall"
          ],
          "text": "The mix's volatility was 11.8% against the tracker's 11.7%, and its largest fall at month-end was 13.2% against 15.0%."
        },
        {
          "claims": [],
          "text": "Before fees, trading costs and tax."
        },
        {
          "claims": [],
          "text": "The tracker already holds these shares, so the 10% adds to a holding it already has."
        }
      ],
      "title": "What does it do next to the tracker?"
    },
