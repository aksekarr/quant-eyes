  "cards": [
    {
      "id": "bumpy",
      "sentences": [
        {
          "claims": [
            "bumpy.volatility"
          ],
          "text": "Its volatility was 22.6% a year, measured on monthly returns in pounds from the end of Sep 2007 to the end of Sep 2026."
        },
        {
          "claims": [
            "bumpy.volatility_common",
            "bumpy.tracker_volatility"
          ],
          "text": "Over the same months as the tracker, from the end of Jan 2010 to the end of Sep 2026, it was 21.3% against the tracker's 11.7%."
        },
        {
          "claims": [],
          "text": "Volatility measures how widely returns swung around their average, up as well as down. It describes the past, not the future."
        }
      ],
      "title": "How bumpy is the ride?"
    },
    {
      "id": "worst",
      "sentences": [
        {
          "claims": [
            "worst.fall",
            "worst.months_to_low"
          ],
          "text": "Since the end of Sep 2007, its largest fall, measured at month-end, was 35.5%: from its high at the end of Dec 2007 to its low at the end of Feb 2009, 14 months later."
        },
        {
          "claims": [
            "worst.ten_thousand_left",
            "worst.ten_thousand_lost"
          ],
          "text": "£10,000 invested at that high would have been worth £6,450 at the low, £3,550 less."
        },
        {
          "claims": [
            "worst.months_to_recover",
            "worst.months_underwater"
          ],
          "text": "It was back at that high by the end of Nov 2009, 9 months after the low and 23 months after the high."
        },
        {
          "claims": [],
          "text": "Falls are measured from one month-end to the next, so a fall that recovered within a month doesn't show. The £10,000 figure applies only to money invested at the high."
        }
      ],
      "title": "What's the worst it's been?"
    },
    {
      "id": "panic",
      "sentences": [
        {
