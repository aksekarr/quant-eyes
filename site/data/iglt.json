      "sentences": [
        {
          "claims": [
            "bumpy.volatility"
          ],
          "text": "Its volatility was 7.2% a year, measured on monthly returns in pounds from the end of Jan 2007 to the end of Sep 2026."
        },
        {
          "claims": [
            "bumpy.volatility_common",
            "bumpy.tracker_volatility"
          ],
          "text": "Over the same months as the tracker, from the end of Jan 2010 to the end of Sep 2026, it was 7.3% against the tracker's 11.7%."
        },
        {
          "claims": [],
          "text": "Volatility measures how widely returns swung around their average, up as well as down. It describes the past, not the future."
        }
      ],
      "title": "How bumpy is the ride?"
    },
    {
      "id": "worst",
      "sentences": [
        {
          "claims": [
            "worst.fall",
            "worst.months_to_low"
          ],
          "text": "Since the end of Jan 2007, its largest fall, measured at month-end, was 31.9%: from its high at the end of May 2020 to its low at the end of Oct 2023, 41 months later."
        },
        {
          "claims": [
            "worst.ten_thousand_left",
            "worst.ten_thousand_lost"
          ],
          "text": "£10,000 invested at that high would have been worth £6,810 at the low, £3,190 less."
        },
        {
          "claims": [
            "worst.below_high_at_end",
            "worst.months_underwater"
          ],
          "text": "It had not recovered by the end of Sep 2026: it was still 26.8% below its high, 76 months after it."
        },
        {
          "claims": [],
          "text": "Falls are measured from one month-end to the next, so a fall that recovered within a month doesn't show. The £10,000 figure applies only to money invested at the high."
        }
      ],
      "title": "What's the worst it's been?"
    },
    {
      "id": "panic",
      "sentences": [
        {
          "claims": [
