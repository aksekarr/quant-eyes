  "cards": [
    {
      "id": "bumpy",
      "sentences": [
        {
          "claims": [
            "bumpy.volatility"
          ],
          "text": "Its volatility was 20.5% a year, measured on monthly returns in pounds from the end of Feb 2005 to the end of Aug 2026."
        },
        {
          "claims": [
            "bumpy.volatility_common",
            "bumpy.tracker_volatility"
          ],
          "text": "Over the same months as the tracker, from the end of Jan 2010 to the end of Aug 2026, it was 20.0% against the tracker's 11.7%."
        },
        {
          "claims": [],
          "text": "Volatility measures how widely returns swung around their average, up as well as down. It describes the past, not the future."
        }
      ],
      "title": "How bumpy is the ride?"
    },
    {
      "id": "worst",
      "sentences": [
        {
          "claims": [
            "worst.fall",
            "worst.months_to_low"
          ],
          "text": "Since the end of Feb 2005, its largest fall, measured at month-end, was 41.0%: from its high at the end of Aug 2006 to its low at the end of Mar 2008, 19 months later."
        },
        {
          "claims": [
            "worst.ten_thousand_left",
            "worst.ten_thousand_lost"
          ],
          "text": "£10,000 invested at that high would have been worth £5,900 at the low, £4,100 less."
        },
        {
          "claims": [
            "worst.months_to_recover",
            "worst.months_underwater"
          ],
          "text": "It was back at that high by the end of Mar 2010, 24 months after the low and 43 months after the high."
        },
        {
          "claims": [],
          "text": "Falls are measured from one month-end to the next, so a fall that recovered within a month doesn't show. The £10,000 figure applies only to money invested at the high."
        }
      ],
      "title": "What's the worst it's been?"
    },
    {
      "id": "panic",
      "sentences": [
        {
          "claims": [
            "panic.gfc"
          ],
          "text": "Global financial crisis (end of Sep 2007 to end of Mar 2009): up 8.7% over the period."
        },
        {
          "claims": [],
          "text": "The tracker: not covered."
        },
        {
          "claims": [
            "panic.covid"
          ],
          "text": "Covid crash (end of Jan 2020 to end of Mar 2020): down 0.8% over the period."
        },
        {
          "claims": [
            "panic.covid.tracker"
          ],
          "text": "The tracker: down 14.5% over the same period."
        },
        {
          "claims": [
            "panic.rate_shock"
          ],
          "text": "2022 rate shock (end of Dec 2021 to end of Oct 2022): up 21.0% over the period."
        },
        {
          "claims": [
            "panic.rate_shock.tracker"
          ],
          "text": "The tracker: down 6.0% over the same period."
        },
        {
          "claims": [],
          "text": "Each figure compares the start and end of the period. Prices may have fallen further in between and partly recovered."
        }
      ],
      "title": "What happened when markets panicked?"
    },
    {
      "id": "next",
      "sentences": [
        {
          "claims": [
            "next.correlation"
          ],
          "text": "Its correlation with the tracker was 0.23, measured on monthly returns in pounds from the end of Jan 2010 to the end of Aug 2026: 1 would mean always moving in step, 0 no pattern, and −1 always opposite."
        },
        {
          "claims": [
            "next.rolling_lowest",
            "next.rolling_highest"
          ],
          "text": "Measured over each 36-month stretch, it ranged from 0.00 (the 36 months to the end of Dec 2024) to 0.54 (the 36 months to the end of Jun 2017)."
        },
        {
          "claims": [],
          "text": "Correlation says how consistently the monthly moves lined up, not how big they were. A low figure is not protection."
        },
        {
          "claims": [
            "next.mix_annualised",
            "next.tracker_annualised"
          ],
          "text": "As an illustration, not a recommendation: from the end of Jan 2010 to the end of Aug 2026, a mix of 90% in the tracker and 10% in this investment, reset to 90/10 at the end of every December, returned 12.7% a year, against 12.5% a year for the tracker alone."
        },
        {
          "claims": [
            "next.mix_volatility",
            "next.tracker_volatility",
            "next.mix_fall",
            "next.tracker_fall"
          ],
          "text": "The mix's volatility was 11.1% against the tracker's 11.7%, and its largest fall at month-end was 13.4% against 15.0%."
        },
        {
          "claims": [],
          "text": "Before fees, trading costs and tax."
        },
        {
          "claims": [],
          "text": "The tracker already holds these shares, so the 10% adds to a holding it already has."
        }
      ],
      "title": "What does it do next to the tracker?"
    },
    {
      "id": "pound",
      "sentences": [
        {
          "claims": [],
          "text": "It is priced in pounds, so there is no separate currency effect to show."
        }
      ],
      "title": "How much of it was the pound?"
    },
