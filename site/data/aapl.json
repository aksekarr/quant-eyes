  "cards": [
    {
      "id": "bumpy",
      "sentences": [
        {
          "claims": [
            "bumpy.volatility"
          ],
          "text": "Its volatility was 28.9% a year, measured on monthly returns in pounds from the end of Aug 2007 to the end of Aug 2026."
        },
        {
          "claims": [
            "bumpy.volatility_common",
            "bumpy.tracker_volatility"
          ],
          "text": "Over the same months as the tracker, from the end of Jan 2010 to the end of Aug 2026, it was 25.7% against the tracker's 11.7%."
        },
        {
          "claims": [],
          "text": "Volatility measures how widely returns swung around their average, up as well as down. It describes the past, not the future."
        }
      ],
      "title": "How bumpy is the ride?"
    },
    {
      "id": "worst",
      "sentences": [
        {
          "claims": [
            "worst.fall",
            "worst.months_to_low"
          ],
          "text": "Since the end of Aug 2007, its largest fall, measured at month-end, was 41.5%: from its high at the end of Dec 2007 to its low at the end of Dec 2008, 12 months later."
        },
        {
          "claims": [
            "worst.ten_thousand_left",
            "worst.ten_thousand_lost"
          ],
          "text": "£10,000 invested at that high would have been worth £5,850 at the low, £4,150 less."
        },
        {
          "claims": [
            "worst.months_to_recover",
            "worst.months_underwater"
          ],
          "text": "It was back at that high by the end of Aug 2009, 8 months after the low and 20 months after the high."
        },
        {
          "claims": [],
          "text": "Falls are measured from one month-end to the next, so a fall that recovered within a month doesn't show. The £10,000 figure applies only to money invested at the high."
        }
      ],
      "title": "What's the worst it's been?"
    },
    {
      "id": "panic",
      "sentences": [
        {
          "claims": [
            "panic.gfc"
          ],
          "text": "Global financial crisis (end of Sep 2007 to end of Mar 2009): down 2.1% over the period."
        },
        {
          "claims": [],
          "text": "The tracker: not covered."
        },
        {
          "claims": [
            "panic.covid"
          ],
          "text": "Covid crash (end of Jan 2020 to end of Mar 2020): down 12.3% over the period."
        },
        {
          "claims": [
            "panic.covid.tracker"
          ],
          "text": "The tracker: down 14.5% over the same period."
        },
        {
          "claims": [
            "panic.rate_shock"
          ],
          "text": "2022 rate shock (end of Dec 2021 to end of Oct 2022): up 2.2% over the period."
        },
        {
          "claims": [
            "panic.rate_shock.tracker"
          ],
          "text": "The tracker: down 6.0% over the same period."
        },
        {
          "claims": [],
          "text": "Each figure compares the start and end of the period. Prices may have fallen further in between and partly recovered."
        }
      ],
      "title": "What happened when markets panicked?"
    },
    {
      "id": "next",
      "sentences": [
        {
          "claims": [
            "next.correlation"
          ],
          "text": "Its correlation with the tracker was 0.53, measured on monthly returns in pounds from the end of Jan 2010 to the end of Aug 2026: 1 would mean always moving in step, 0 no pattern, and −1 always opposite."
        },
        {
          "claims": [
            "next.rolling_lowest",
            "next.rolling_highest"
          ],
          "text": "Measured over each 36-month stretch, it ranged from 0.13 (the 36 months to the end of Mar 2013) to 0.74 (the 36 months to the end of Nov 2023)."
        },
        {
          "claims": [],
          "text": "Correlation says how consistently the monthly moves lined up, not how big they were. A low figure is not protection."
        },
        {
          "claims": [
            "next.mix_annualised",
            "next.tracker_annualised"
          ],
          "text": "As an illustration, not a recommendation: from the end of Jan 2010 to the end of Aug 2026, a mix of 90% in the tracker and 10% in this investment, reset to 90/10 at the end of every December, returned 14.3% a year, against 12.5% a year for the tracker alone."
        },
        {
          "claims": [
            "next.mix_volatility",
            "next.tracker_volatility",
            "next.mix_fall",
            "next.tracker_fall"
          ],
          "text": "The mix's volatility was 12.1% against the tracker's 11.7%, and its largest fall at month-end was 14.3% against 15.0%."
        },
        {
          "claims": [],
          "text": "Before fees, trading costs and tax."
        },
        {
          "claims": [],
          "text": "The tracker already holds these shares, so the 10% adds to a holding it already has."
        }
      ],
      "title": "What does it do next to the tracker?"
    },
    {
      "id": "pound",
      "sentences": [
        {
          "claims": [
            "pound.local",
            "pound.currency",
            "pound.gbp"
          ],
          "text": "From the end of Aug 2007 to the end of Aug 2026: up 7,550.2% in dollars, and the dollar rose 48.9% against the pound, so in pounds it was up 11,290.4%."
        },
        {
          "claims": [
            "pound.gfc.local",
            "pound.gfc.currency",
            "pound.gfc.gbp"
          ],
          "text": "Global financial crisis: down 31.5% in dollars, the dollar rose 43.0%, so down 2.1% in pounds."
        },
        {
          "claims": [
            "pound.covid.local",
            "pound.covid.currency",
            "pound.covid.gbp"
          ],
          "text": "Covid crash: down 17.6% in dollars, the dollar rose 6.5%, so down 12.3% in pounds."
        },
        {
          "claims": [
            "pound.rate_shock.local",
            "pound.rate_shock.currency",
            "pound.rate_shock.gbp"
          ],
          "text": "2022 rate shock: down 13.3% in dollars, the dollar rose 17.9%, so up 2.2% in pounds."
        },
        {
          "claims": [],
          "text": "The two parts multiply rather than add, so they never simply add up to the figure in pounds."
        }
      ],
      "title": "How much of it was the pound?"
    },
    {
      "id": "limits",
      "sentences": [
        {
          "claims": [],
          "text": "A single company's shares can fall a long way and stay down, and the company can fail."
        },
        {
          "claims": [],
          "text": "These are past results in pounds, measured at month-ends, before platform fees, trading costs and tax. Past behaviour does not predict future results."
        }
      ],
      "title": "What these numbers don't capture"
    }
  ],
