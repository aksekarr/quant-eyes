 "cases": [
  {
   "id": "W01",
   "check": "stress_windows",
   "series": "W_gfc",
   "expected": [
    {
     "window": "gfc",
     "start": "2007-09",
     "end": "2009-03",
     "covered": true,
     "return": -0.45
    },
    {
     "window": "covid",
     "start": "2020-01",
     "end": "2020-03",
     "covered": false,
     "return": null
    },
    {
     "window": "rate_shock",
     "start": "2021-12",
     "end": "2022-10",
     "covered": false,
     "return": null
    }
   ],
   "derivation": "Sep 2007 month-end 100, Mar 2009 month-end 55: 55/100 - 1 = -45% over the period. The series fell further inside the window (to 50 in Nov 2008, -50%), which is why an episode return is not a largest fall. Covid and rate-shock months are not in the series: not covered."
  },
