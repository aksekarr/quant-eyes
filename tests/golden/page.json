  "cases": [
    {"id": "C01", "check": "check_context", "context": "CTX", "expected": "valid",
     "derivation": "One entry per asset (usa, gbf), none for the benchmark, true/false values, a reason each, safe links."},
    {"id": "C02", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "gbf"], "delete": true}], "expected_error": "WordsError", "message_must_contain": ["gbf"],
     "derivation": "An asset with no facts would get no card 5 or 6 wording."},
    {"id": "C03", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "trk"], "set": {"held_by_tracker": true, "priced_in_pounds_holds_dollars": false, "why": "x"}}], "expected_error": "WordsError", "message_must_contain": ["trk"],
     "derivation": "The benchmark has no page, so no facts."},
    {"id": "C04", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "zzz"], "set": {"held_by_tracker": false, "priced_in_pounds_holds_dollars": false, "why": "x"}}], "expected_error": "WordsError", "message_must_contain": ["zzz"],
     "derivation": "Facts for an instrument not in the list."},
    {"id": "C05", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "usa", "held_by_tracker"], "set": 1}], "expected_error": "WordsError", "message_must_contain": ["usa", "held_by_tracker"],
     "derivation": "1 is not true."},
    {"id": "C06", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "usa", "why"], "set": ""}], "expected_error": "WordsError", "message_must_contain": ["usa", "why"],
     "derivation": "Every fact needs its reason."},
    {"id": "C07", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "usa", "notes"], "set": "x"}], "expected_error": "WordsError", "message_must_contain": ["usa", "notes"],
     "derivation": "Unknown key."},
    {"id": "C08", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["instruments", "usa", "priced_in_pounds_holds_dollars"], "set": true}], "expected_error": "WordsError", "message_must_contain": ["usa", "priced_in_pounds_holds_dollars"],
     "derivation": "usa trades in dollars, so it can't be 'priced in pounds'. Caught here, before any card is built."},
    {"id": "C09", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["sources", "index"], "set": "https://index.example.com/?apikey=SECRET1"}], "expected_error": "WordsError", "message_must_contain": ["index"], "message_must_not_contain": ["SECRET1"],
     "derivation": "Same URL rule as the instrument list (section 8.1); the URL is never repeated."},
    {"id": "C10", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["facts_checked"], "set": "2026-02-30"}], "expected_error": "WordsError", "message_must_contain": ["facts_checked"],
     "derivation": "Not a date."},
    {"id": "C11", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["extra"], "set": 1}], "expected_error": "WordsError", "message_must_contain": ["extra"],
     "derivation": "Top-level keys are exactly about, facts_checked, sources, instruments."},
    {"id": "C12", "check": "check_context", "context": "CTX", "context_edits": [{"path": ["sources"], "set": {}}], "expected_error": "WordsError", "message_must_contain": ["sources"],
     "derivation": "At least one source."},

