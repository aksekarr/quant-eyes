     "expected_error": "WordsError", "message_must_contain": ["data_as_of"],
     "derivation": "Every page states its data-as-of month."},
    {"id": "P03", "check": "build_page", "document": "DOC_USA", "document_edits": [{"path": ["results", "method_version"], "set": null}], "facts": {"held_by_tracker": true, "priced_in_pounds_holds_dollars": false},
     "expected_error": "WordsError", "message_must_contain": ["method_version"],
     "derivation": "Every page states the method version its numbers came from."},

