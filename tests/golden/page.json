    {"id": "N02", "check": "build_index",
     "pages": [
       {"document": "DOC_USA", "facts": {"held_by_tracker": true, "priced_in_pounds_holds_dollars": false}, "page_edits": []},
       {"document": "DOC_USA", "facts": {"held_by_tracker": false, "priced_in_pounds_holds_dollars": false}, "page_edits": [{"path": ["instrument", "id"], "set": "gbf"}, {"path": ["data_as_of"], "set": "2026-07"}]}],
     "expected_error": "WordsError", "message_must_contain": ["data_as_of"],
     "derivation": "Pages with different as-of months: one date must stand for the whole site."},
    {"id": "N03", "check": "build_index",
     "pages": [
