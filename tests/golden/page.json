{
  "file": "page",
  "spec": "docs/METHODOLOGY.md section 13",
  "authorship": "Expected values written by hand by Claude (architect), checked against a separate Claude-only reference implementation, committed by Avi. Codex must never edit this file. If a case fails and you believe the expected value is wrong, stop and report the case ID and your reasoning.",
  "interface": {
    "module": "words.page",
    "errors": "WordsError is words.cards.WordsError, imported, never redefined.",
    "PAGE_VERSION / INDEX_VERSION": "Both the string \"1\".",
    "check_context(context, registry)": "Returns None or raises WordsError. Section 13.1. The registry has already passed check_registry.",
    "build_page(document, facts)": "Returns the page (section 13.2). The document has already passed check_document; facts is the asset's context entry without its \"why\".",
    "build_index(registry, pages)": "Returns the index (section 13.3)."
  },
  "case_fields": {
    "registry": "The registry below (deep copy). context / document: the named fixture (deep copy); *_edits applied with apply_edits.",
    "facts": "Passed as given.",
    "expected_page": "The page must equal this dictionary with two keys added: \"cards\", equal to build_cards(document)[\"cards\"] followed by build_cards_567(document, facts)[\"cards\"], and \"claims\", equal to build_cards(document)[\"claims\"] followed by build_cards_567(document, facts)[\"claims\"]. Compare with assert_result_equal, tolerance 0.",
    "pages": "build_index cases: a list with one entry per page, each {\"document\", \"facts\", \"page_edits\"}. Build each page with build_page from a deep copy of the named document and the given facts, apply that entry's page_edits (an edit list, may be empty) with apply_edits, then pass the pages to build_index in the order given."
  },
