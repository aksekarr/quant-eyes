{
  "file": "publish",
  "spec": "docs/METHODOLOGY.md section 8",
  "authorship": "Expected values written by hand by Claude (architect), checked against a separate Claude-only reference implementation, committed by Avi. Codex must never edit this file. If a case fails and you believe the expected value is wrong, stop and report the case ID and your reasoning.",
  "interface": {
    "module": "pipeline.publish",
    "errors": "RegistryError (bad instrument list) and PublishError (a published document breaks a rule) are defined in pipeline.publish. OutputError is the engine's, from engine.output, and is never caught, wrapped or redefined. Bad arguments raise the built-in ValueError.",
    "DOCUMENT_VERSION": "The string \"1\".",
    "check_registry(registry)": "Returns None or raises RegistryError. Section 8.1.",
    "build_document(registry, instrument_id, results, as_of_month, generated_on)": "Returns the document (section 8.2), after checking it with check_document. generated_on must be a datetime.date and not a datetime.datetime.",
    "check_document(document, registry)": "Returns None or raises PublishError (or the engine's OutputError). Section 8.3."
  },
  "case_fields": {
    "registry": "Name of an entry in \"registries\". Tests pass a deep copy.",
    "registry_edits / results_edits / document_edits": "Edits applied to a deep copy of the named fixture before the call, in order. {\"path\": [...], \"set\": v} sets the final key or list index to v (adding a key if absent); {\"path\": [...], \"delete\": true} removes the final key. Path items are dictionary keys (strings) or list indexes (integers).",
    "registry_file": "A path relative to the repo root: load that JSON file and pass it to check_registry.",
    "results": "Name of an entry in \"results\".",
    "document": "Name of an entry in \"documents\".",
    "round_trip": "If true, pass the document through json.dumps then json.loads before check_document.",
    "generated_on": "A YYYY-MM-DD string: build a datetime.date. generated_on_datetime: build a datetime.datetime. generated_on_raw: pass the JSON value as given.",
    "in_place_registry_edits": "document_independent only: after build_document returns, apply these edits to the very registry object that was passed in (in place, no copy), then compare the already-returned document with expected_document.",
    "expected": "\"valid\" means the call returns None without raising.",
    "expected_document": "Name of an entry in \"documents\": the returned document must equal it exactly (same keys, types and values)."
  },
  "registries": {
    "REG": {
      "about": "Synthetic instrument list for tests.",
      "facts_checked": "2026-09-28",
      "providers": {
        "prova": {"name": "Provider A", "url": "https://a.example.com"},
        "provb": {"name": "Provider B", "url": "https://b.example.com"}
      },
      "fx": {
        "label": "US dollars per pound",
        "data": {"provider": "provb", "kind": "fx", "symbol": "GBP/USD", "field": "4. close", "currency": "USD", "basis": "fx_rate", "start": null}
      },
      "instruments": [
        {"id": "trk", "role": "benchmark", "label": "Test tracker",
         "identity": {"name": "Test Tracker ETF", "share_class": "USD (Acc)", "type": "etf", "isin": "IE00TEST0001", "ticker": "TRK", "exchange": "Test exchange", "trading_currency": "GBP", "quote_unit": "pence", "income": "accumulating", "currency_hedged": false, "sources": ["https://issuer.example.com/trk"]},
         "data": {"provider": "provb", "kind": "equity", "symbol": "TRK.X", "field": "5. adjusted close", "currency": "GBP", "basis": "total_return", "start": null}},
        {"id": "usa", "role": "asset", "label": "US share",
         "identity": {"name": "Test US Corp", "share_class": "Common stock", "type": "share", "isin": "US00TEST0002", "ticker": "USA", "exchange": "Test US exchange", "trading_currency": "USD", "quote_unit": "dollars", "income": "dividends", "currency_hedged": null, "sources": ["https://issuer.example.com/usa"]},
         "data": {"provider": "prova", "kind": "equity", "symbol": "USA", "field": "adjClose", "currency": "USD", "basis": "total_return", "start": null}},
        {"id": "gbf", "role": "asset", "label": "UK fund",
         "identity": {"name": "Test UK Fund", "share_class": "GBP (Dist)", "type": "etf", "isin": "IE00TEST0003", "ticker": "GBF", "exchange": "Test exchange", "trading_currency": "GBP", "quote_unit": "pounds", "income": "distributing", "currency_hedged": false, "sources": ["https://issuer.example.com/gbf", "https://broker.example.com/gbf"]},
         "data": {"provider": "provb", "kind": "equity", "symbol": "GBF.X", "field": "5. adjusted close", "currency": "GBP", "basis": "total_return", "start": null}},
        {"id": "cry", "role": "asset", "label": "Test coin",
         "identity": {"name": "Testcoin", "share_class": null, "type": "cryptocurrency", "isin": null, "ticker": "CRY", "exchange": null, "trading_currency": "USD", "quote_unit": "dollars", "income": "none", "currency_hedged": null, "sources": ["https://docs.example.com/crypto"]},
         "data": {"provider": "prova", "kind": "crypto", "symbol": "cryusd", "field": "close", "currency": "USD", "basis": "total_return", "start": "2014-12"}},
        {"id": "gld", "role": "asset", "label": "Gold ETC",
         "identity": {"name": "Test Gold ETC", "share_class": null, "type": "etc", "isin": "IE00TEST0004", "ticker": "GLD1", "exchange": "Test exchange", "trading_currency": "GBP", "quote_unit": "pence", "income": "none", "currency_hedged": false, "sources": ["https://issuer.example.com/gld"]},
         "data": {"provider": "provb", "kind": "equity", "symbol": "GLD1.X", "field": "5. adjusted close", "currency": "GBP", "basis": "total_return", "start": null}}
      ]
    }
  },
  "results": {
    "RES_USA": {"method_version": "1.0", "asset_currency": "USD",
      "own": {"start": "2007-08", "end": "2026-08", "months": 228, "total_return": 1.5},
      "side_by_side": {"asset": {"start": "2009-12", "end": "2026-08"}, "tracker": {"start": "2009-12", "end": "2026-08"}, "correlation": 0.5},
      "currency": {"full_history": null, "stress_windows": [{"window": "gfc", "covered": false}, {"window": "covid", "covered": true}, {"window": "rate_shock", "covered": true}]}},
    "RES_GBF": {"method_version": "1.0", "asset_currency": "GBP",
      "own": {"start": "2009-12", "end": "2026-08"},
      "side_by_side": {"asset": {"start": "2009-12", "end": "2026-08"}, "tracker": {"start": "2009-12", "end": "2026-08"}},
      "currency": null},
    "RES_CRY": {"method_version": "1.0", "asset_currency": "USD",
      "own": {"start": "2014-12", "end": "2026-08"},
      "side_by_side": {"asset": {"start": "2014-12", "end": "2026-08"}, "tracker": {"start": "2014-12", "end": "2026-08"}},
      "currency": {"full_history": null, "stress_windows": [{"window": "gfc", "covered": false}, {"window": "covid", "covered": true}, {"window": "rate_shock", "covered": true}]}}
  },
  "documents": {
