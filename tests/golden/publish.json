  "cases": [
    {"id": "R01", "check": "check_registry", "registry": "REG", "expected": "valid",
     "derivation": "The synthetic list follows every rule in 8.1: one benchmark in GBP, safe ids, identity fields consistent with each type."},
    {"id": "R02", "check": "registry_file", "registry_file": "pipeline/instruments.json", "expected": "valid",
     "derivation": "The real v1 instrument list must itself pass. This is what stops a typo in the real facts."},
    {"id": "R03", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["notes"], "set": "x"}], "expected_error": "RegistryError", "message_must_contain": ["notes"],
     "derivation": "Unknown top-level key. The key sets are exact, so a misspelt key cannot be silently ignored."},
    {"id": "R04", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["fx"], "delete": true}], "expected_error": "RegistryError", "message_must_contain": ["fx"],
     "derivation": "Missing top-level key fx."},
    {"id": "R05", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["facts_checked"], "set": "2026-02-30"}], "expected_error": "RegistryError", "message_must_contain": ["facts_checked"],
     "derivation": "30 February is not a date."},
    {"id": "R06", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["providers", "prova", "url"], "set": "https://a.example.com/?apikey=SECRET123"}], "expected_error": "RegistryError", "message_must_contain": ["prova", "url"], "message_must_not_contain": ["SECRET123"],
     "derivation": "A URL with a query string could carry an API key into a public file. Refused, and the message never repeats the URL."},
    {"id": "R07", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["providers", "prova", "url"], "set": "http://a.example.com"}], "expected_error": "RegistryError", "message_must_contain": ["prova", "url"],
     "derivation": "Only https URLs."},
    {"id": "R08", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments"], "set": []}], "expected_error": "RegistryError", "message_must_contain": ["instruments"],
     "derivation": "An empty list has no benchmark and nothing to publish."},
    {"id": "R09", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "id"], "set": "usa"}], "expected_error": "RegistryError", "message_must_contain": ["usa"],
     "derivation": "Duplicate id. Ids name the published files, so a duplicate would overwrite one asset's file with another's."},
    {"id": "R10", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "id"], "set": "../gbf"}], "expected_error": "RegistryError", "message_must_contain": ["id"],
     "derivation": "An id becomes a file name. \"../gbf\" would write outside the output folder."},
    {"id": "R11", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "id"], "set": "GBF"}], "expected_error": "RegistryError", "message_must_contain": ["id"],
     "derivation": "Ids are lower case: letters and digits, starting with a letter, 2 to 20 characters."},
    {"id": "R12", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "role"], "set": "benchmark"}], "expected_error": "RegistryError", "message_must_contain": ["benchmark"],
     "derivation": "Two benchmarks (trk and gbf, both in GBP). Exactly one is allowed."},
    {"id": "R13", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 0, "role"], "set": "asset"}], "expected_error": "RegistryError", "message_must_contain": ["benchmark"],
     "derivation": "No benchmark at all."},
    {"id": "R14", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 0, "identity", "trading_currency"], "set": "USD"}, {"path": ["instruments", 0, "identity", "quote_unit"], "set": "dollars"}, {"path": ["instruments", 0, "data", "currency"], "set": "USD"}], "expected_error": "RegistryError", "message_must_contain": ["trk"],
     "derivation": "The benchmark is consistent with itself but trades in dollars. The tracker must be in GBP (section 6.1); refused here, before any data is fetched."},
    {"id": "R15", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "notes"], "set": "x"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "notes"],
     "derivation": "Unknown identity key."},
    {"id": "R16", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "quote_unit"], "delete": true}], "expected_error": "RegistryError", "message_must_contain": ["usa", "quote_unit"],
     "derivation": "Missing identity key."},
    {"id": "R17", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 0, "identity", "quote_unit"], "set": "dollars"}], "expected_error": "RegistryError", "message_must_contain": ["trk", "quote_unit"],
     "derivation": "Trades in GBP but quoted in dollars. GBP lines are quoted in pence or pounds."},
    {"id": "R18", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "quote_unit"], "set": "pence"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "quote_unit"],
     "derivation": "Trades in USD but quoted in pence. USD lines are quoted in dollars."},
    {"id": "R19", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "data", "currency"], "set": "USD"}], "expected_error": "RegistryError", "message_must_contain": ["gbf", "currency"],
     "derivation": "The engine label (data currency) must be the trading currency. A GBP fund labelled USD would be divided by the exchange rate."},
    {"id": "R20", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "isin"], "set": "US00TEST000"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "isin"],
     "derivation": "11 characters. An ISIN is 2 capital letters, 9 capital letters or digits, then 1 digit."},
    {"id": "R21", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "isin"], "set": null}], "expected_error": "RegistryError", "message_must_contain": ["usa", "isin"],
     "derivation": "Only a cryptocurrency has no ISIN."},
    {"id": "R22", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 3, "identity", "isin"], "set": "XX00TEST0005"}], "expected_error": "RegistryError", "message_must_contain": ["cry", "isin"],
     "derivation": "A cryptocurrency must have no ISIN."},
    {"id": "R23", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "exchange"], "set": null}], "expected_error": "RegistryError", "message_must_contain": ["usa", "exchange"],
     "derivation": "Only a cryptocurrency has no exchange."},
    {"id": "R24", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 3, "identity", "exchange"], "set": "Test exchange"}], "expected_error": "RegistryError", "message_must_contain": ["cry", "exchange"],
     "derivation": "A cryptocurrency must have no exchange: its price comes from a feed across many."},
    {"id": "R25", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "identity", "income"], "set": "dividends"}], "expected_error": "RegistryError", "message_must_contain": ["gbf", "income"],
     "derivation": "An ETF is accumulating or distributing."},
    {"id": "R26", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 4, "identity", "income"], "set": "accumulating"}], "expected_error": "RegistryError", "message_must_contain": ["gld", "income"],
     "derivation": "An ETC pays no income: none."},
    {"id": "R27", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "currency_hedged"], "set": false}], "expected_error": "RegistryError", "message_must_contain": ["usa", "currency_hedged"],
     "derivation": "Hedging doesn't apply to a share: it must be null, not false."},
    {"id": "R28", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "identity", "currency_hedged"], "set": null}], "expected_error": "RegistryError", "message_must_contain": ["gbf", "currency_hedged"],
     "derivation": "For an ETF, whether it is hedged must be stated: true or false."},
    {"id": "R29", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "identity", "currency_hedged"], "set": 0}], "expected_error": "RegistryError", "message_must_contain": ["gbf", "currency_hedged"],
     "derivation": "0 is not false. Python treats 0 == False as true, so a check written as 'value in (True, False)' would wrongly accept it."},
    {"id": "R30", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "sources"], "set": []}], "expected_error": "RegistryError", "message_must_contain": ["usa", "sources"],
     "derivation": "Every identity needs at least one source link."},
    {"id": "R31", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "sources", 0], "set": "https://issuer.example.com/usa#top"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "sources"],
     "derivation": "No # fragment (or ? query) in any URL."},
    {"id": "R32", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "type"], "set": "fund"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "type"],
     "derivation": "Types are etf, etc, share or cryptocurrency."},
    {"id": "R33", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "identity", "share_class"], "set": null}], "expected_error": "RegistryError", "message_must_contain": ["gbf", "share_class"],
     "derivation": "An ETF must name its share class (accumulating and distributing classes of one fund are different instruments)."},
    {"id": "R34", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "data", "provider"], "set": "provc"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "provider"],
     "derivation": "Provider must be one listed under providers."},
    {"id": "R35", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "data", "kind"], "set": "crypto"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "kind"],
     "derivation": "Kind crypto is for a cryptocurrency only."},
    {"id": "R36", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 3, "data", "kind"], "set": "equity"}], "expected_error": "RegistryError", "message_must_contain": ["cry", "kind"],
     "derivation": "A cryptocurrency is fetched with kind crypto."},
    {"id": "R37", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 2, "data", "basis"], "set": "price"}], "expected_error": "RegistryError", "message_must_contain": ["gbf", "basis"],
     "derivation": "Instruments are total_return only (section 6.1)."},
    {"id": "R38", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 3, "data", "start"], "set": "2014-13"}], "expected_error": "RegistryError", "message_must_contain": ["cry", "start"],
     "derivation": "Start is null or a YYYY-MM month from 01 to 12."},
    {"id": "R39", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "data", "notes"], "set": "x"}], "expected_error": "RegistryError", "message_must_contain": ["usa", "notes"],
     "derivation": "Unknown data key."},
    {"id": "R40", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["fx", "data", "basis"], "set": "total_return"}], "expected_error": "RegistryError", "message_must_contain": ["fx", "basis"],
     "derivation": "The exchange rate's basis is fx_rate."},
    {"id": "R41", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["fx", "data", "currency"], "set": "GBP"}], "expected_error": "RegistryError", "message_must_contain": ["fx", "currency"],
     "derivation": "The rate is US dollars per pound, labelled USD (section 2.1)."},
    {"id": "R42", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "label"], "set": ""}], "expected_error": "RegistryError", "message_must_contain": ["usa", "label"],
     "derivation": "Empty label."},
    {"id": "R43", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "name"], "set": true}], "expected_error": "RegistryError", "message_must_contain": ["usa", "name"],
     "derivation": "A name must be text."},
    {"id": "R44", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "role"], "delete": true}], "expected_error": "RegistryError", "message_must_contain": ["usa", "role"],
     "derivation": "Missing role."},
    {"id": "R45", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "ticker"], "set": ""}], "expected_error": "RegistryError", "message_must_contain": ["usa", "ticker"],
     "derivation": "Empty ticker."},
    {"id": "R46", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 3, "identity", "share_class"], "set": "Coins"}], "expected_error": "RegistryError", "message_must_contain": ["cry", "share_class"],
     "derivation": "A cryptocurrency has no share class."},
    {"id": "R47", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 3, "identity", "income"], "set": "dividends"}], "expected_error": "RegistryError", "message_must_contain": ["cry", "income"],
     "derivation": "A cryptocurrency pays no income."},
    {"id": "R48", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["fx", "data", "kind"], "set": "equity"}], "expected_error": "RegistryError", "message_must_contain": ["fx", "kind"],
     "derivation": "The exchange rate is fetched with kind fx."},
    {"id": "R49", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["providers", "prova", "name"], "set": ""}], "expected_error": "RegistryError", "message_must_contain": ["prova", "name"],
     "derivation": "A provider needs a name for attribution."},
    {"id": "R50", "check": "check_registry", "registry": "REG", "registry_edits": [{"path": ["instruments", 4, "data", "kind"], "set": "fx"}], "expected_error": "RegistryError", "message_must_contain": ["gld", "kind"],
     "derivation": "Kind fx is for the exchange rate only."},

    {"id": "P01", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_document": "DOC_USA",
     "derivation": "A dollar asset. Sources in order of first use: the asset's provider (A: US share), then the benchmark's (B: Test tracker), then the exchange rate's (B again, so added to B's entry: US dollars per pound). Identity copied exactly. Results unchanged."},
    {"id": "P02", "check": "build_document", "registry": "REG", "instrument_id": "gbf", "results": "RES_GBF", "as_of_month": "2026-08", "generated_on": "2026-09-01", "expected_document": "DOC_GBF",
     "derivation": "A pound asset: no exchange rate, so no fx source. Asset and benchmark share provider B: one entry, asset first. Generated on 1 September, the first day after August ends: allowed."},
    {"id": "P03", "check": "build_document", "registry": "REG", "instrument_id": "cry", "results": "RES_CRY", "as_of_month": "2026-08", "generated_on": "2026-10-15", "expected_document": "DOC_CRY",
     "derivation": "The instrument has a start month (2014-12) and its results start there. Null identity fields are copied as null."},
    {"id": "P04", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on": "2026-08-31", "expected_error": "ValueError",
     "derivation": "Generated on the last day of the as-of month: August had not finished, so data 'as of August' can't have been complete (section 7.2)."},
    {"id": "P05", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on_datetime": "2026-09-28T09:00:00", "expected_error": "ValueError",
     "derivation": "A date and time, not a date."},
    {"id": "P06", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on_raw": "2026-09-28", "expected_error": "ValueError",
     "derivation": "Text, not a date."},
    {"id": "P07", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-8", "generated_on": "2026-09-28", "expected_error": "ValueError",
     "derivation": "Not YYYY-MM."},
    {"id": "P08", "check": "build_document", "registry": "REG", "instrument_id": "trk", "results": "RES_GBF", "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "ValueError",
     "derivation": "The benchmark has no page of its own in v1."},
    {"id": "P09", "check": "build_document", "registry": "REG", "instrument_id": "zzz", "results": "RES_USA", "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "ValueError",
     "derivation": "Unknown instrument."},
    {"id": "P10", "check": "build_document", "registry": "REG", "registry_edits": [{"path": ["instruments", 1, "identity", "quote_unit"], "set": "pence"}], "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "RegistryError",
     "derivation": "build_document checks the instrument list first."},
    {"id": "P11", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["own", "end"], "set": "2026-07"}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["own"],
     "derivation": "The asset's own history ends in July but the file would say 'data as of August'. Every instrument must reach the as-of month."},
    {"id": "P12", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["side_by_side", "tracker", "end"], "set": "2026-07"}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["tracker"],
     "derivation": "The side-by-side tracker figures end in July."},
    {"id": "P13", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_GBF", "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["asset_currency"],
     "derivation": "A pound asset's results given for a dollar instrument: the wrong asset's numbers. asset_currency is checked before currency (8.3), so it is what the message names."},
    {"id": "P14", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["method_version"], "set": "0.9"}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["method_version"],
     "derivation": "Results from a method other than the engine's current one are not published."},
    {"id": "P15", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["prices"], "set": [101.5, 103, 105.25]}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "OutputError",
     "derivation": "Something shaped like a series. The engine's own output rule refuses it, reused rather than rewritten, and its OutputError is not wrapped."},
    {"id": "P16", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["note"], "set": "x"}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["note"],
     "derivation": "Passes the engine's shape rule but isn't one of the five result keys."},
    {"id": "P17", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["own"], "set": null}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["own"],
     "derivation": "No own-history results: nothing to publish."},
    {"id": "P18", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["side_by_side"], "set": null}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["side_by_side"],
     "derivation": "No side-by-side results: card 5 would be empty. Not published."},
    {"id": "P19", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["currency"], "set": null}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["currency"],
     "derivation": "A dollar asset must have its currency results."},
    {"id": "P20", "check": "build_document", "registry": "REG", "instrument_id": "gbf", "results": "RES_GBF", "results_edits": [{"path": ["currency"], "set": {"full_history": null, "stress_windows": [{"window": "gfc", "covered": false}, {"window": "covid", "covered": true}, {"window": "rate_shock", "covered": true}]}}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["currency"],
     "derivation": "A pound asset must have no currency results."},
    {"id": "P21", "check": "build_document", "registry": "REG", "instrument_id": "cry", "results": "RES_CRY", "results_edits": [{"path": ["own", "start"], "set": "2015-01"}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["start"],
     "derivation": "The instrument's start month is 2014-12 but its results start in 2015-01: the start was not applied as stated."},
    {"id": "P22", "check": "build_document", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "results_edits": [{"path": ["side_by_side", "asset", "end"], "set": "2026-07"}], "as_of_month": "2026-08", "generated_on": "2026-09-28", "expected_error": "PublishError", "message_must_contain": ["asset"],
     "derivation": "The side-by-side asset figures end in July."},

    {"id": "C01", "check": "check_document", "document": "DOC_USA", "registry": "REG", "expected": "valid",
     "derivation": "P01's document passes the check on its own."},
    {"id": "C02", "check": "check_document", "document": "DOC_USA", "registry": "REG", "round_trip": true, "expected": "valid",
     "derivation": "It still passes after being written as JSON text and read back, which is what the site will receive."},
    {"id": "C03", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["instrument", "identity", "quote_unit"], "set": "pounds"}], "expected_error": "PublishError", "message_must_contain": ["instrument"],
     "derivation": "The published identity must be exactly the checked facts in the instrument list."},
    {"id": "C04", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["benchmark", "label"], "set": "Tracker"}], "expected_error": "PublishError", "message_must_contain": ["benchmark"],
     "derivation": "Same for the benchmark."},
    {"id": "C05", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["sources", 1, "url"], "set": "https://b.example.com/?apikey=SECRET123"}], "expected_error": "PublishError", "message_must_contain": ["sources"], "message_must_not_contain": ["SECRET123"],
     "derivation": "Sources must be exactly those built from the instrument list. The message never repeats a URL."},
    {"id": "C06", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["sources", 1, "used_for", 1], "delete": true}], "expected_error": "PublishError", "message_must_contain": ["sources"],
     "derivation": "The exchange rate's source is missing from a dollar asset's file."},
    {"id": "C07", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["raw"], "set": [101.5, 103]}], "expected_error": "PublishError", "message_must_contain": ["raw"],
     "derivation": "Unknown top-level key."},
    {"id": "C08", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["document_version"], "set": "2"}], "expected_error": "PublishError", "message_must_contain": ["document_version"],
     "derivation": "Only document version 1 exists."},
    {"id": "C09", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["generated_on"], "set": "2026-08-15"}], "expected_error": "PublishError", "message_must_contain": ["generated_on"],
     "derivation": "Generated before the as-of month ended."},
    {"id": "C10", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["generated_on"], "set": "2026-02-30"}], "expected_error": "PublishError", "message_must_contain": ["generated_on"],
     "derivation": "Not a date."},
    {"id": "C11", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["data_as_of"], "set": "2026-07"}], "expected_error": "PublishError", "message_must_contain": ["own"],
     "derivation": "The file says July but the results run to August: own end doesn't match the as-of month."},
    {"id": "C12", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["instrument"], "set": {"id": "trk", "label": "Test tracker", "identity": {"name": "Test Tracker ETF", "share_class": "USD (Acc)", "type": "etf", "isin": "IE00TEST0001", "ticker": "TRK", "exchange": "Test exchange", "trading_currency": "GBP", "quote_unit": "pence", "income": "accumulating", "currency_hedged": false, "sources": ["https://issuer.example.com/trk"]}}}], "expected_error": "PublishError", "message_must_contain": ["instrument"],
     "derivation": "A document about the benchmark, copied exactly from the list. Still refused: the benchmark has no page."},
    {"id": "C13", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["instrument", "id"], "set": "zzz"}], "expected_error": "PublishError", "message_must_contain": ["instrument"],
     "derivation": "Unknown instrument."},
    {"id": "C14", "check": "check_document", "document": "DOC_GBF", "registry": "REG", "document_edits": [{"path": ["sources", 0, "used_for", 2], "set": "US dollars per pound"}], "expected_error": "PublishError", "message_must_contain": ["sources"],
     "derivation": "A pound asset's file credits a source for an exchange rate it didn't use."},
    {"id": "C15", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["data_as_of"], "set": "2026-13"}], "expected_error": "PublishError", "message_must_contain": ["data_as_of"],
     "derivation": "Month 13."},
    {"id": "C16", "check": "check_document", "document": "DOC_USA", "registry": "REG", "document_edits": [{"path": ["benchmark", "identity", "currency_hedged"], "set": 0}], "expected_error": "PublishError", "message_must_contain": ["benchmark"],
     "derivation": "'Exactly its copy' means the same types too. 0 is not false, even though Python's == says 0 == False; a comparison that allowed it would publish 0 where the list says false. The document-level twin of R29."},

    {"id": "I01", "check": "document_independent", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on": "2026-09-28",
     "in_place_registry_edits": [{"path": ["instruments", 1, "identity", "name"], "set": "Changed"}, {"path": ["instruments", 0, "label"], "set": "Changed"}, {"path": ["providers", "prova", "name"], "set": "Changed"}],
     "expected_document": "DOC_USA",
     "derivation": "The document holds its own copies. Changing the instrument list afterwards (as the runner's shared list could be) must not change a document already built."},
    {"id": "I02", "check": "document_independent", "registry": "REG", "instrument_id": "usa", "results": "RES_USA", "as_of_month": "2026-08", "generated_on": "2026-09-28",
     "in_place_registry_edits": [{"path": ["instruments", 1, "identity", "sources", 0], "set": "https://changed.example.com"}, {"path": ["instruments", 0, "identity", "sources", 0], "set": "https://changed.example.com"}],
     "expected_document": "DOC_USA",
     "derivation": "The copies go all the way down: a list inside the identity is copied too, not shared."}
  ]
}
