      "benchmark": {"id": "trk", "label": "Test tracker",
        "identity": {"name": "Test Tracker ETF", "share_class": "USD (Acc)", "type": "etf", "isin": "IE00TEST0001", "ticker": "TRK", "exchange": "Test exchange", "trading_currency": "GBP", "quote_unit": "pence", "income": "accumulating", "currency_hedged": false, "sources": ["https://issuer.example.com/trk"]}},
      "data_as_of": "2026-08",
      "generated_on": "2026-10-15",
      "sources": [
        {"provider": "Provider A", "url": "https://a.example.com", "used_for": ["Test coin"]},
        {"provider": "Provider B", "url": "https://b.example.com", "used_for": ["Test tracker", "US dollars per pound"]}
      ],
      "results": {"method_version": "1.0", "asset_currency": "USD",
        "own": {"start": "2014-12", "end": "2026-08"},
