  "cases": [
    {"id": "D01", "check": "percent_display", "value": 0.46094, "expected": {"points": 46.1, "text": "46.1%"},
     "derivation": "0.46094 x 100 = 46.094; one decimal place, half-up: 46.1."},
    {"id": "D02", "check": "percent_display", "value": -0.72536, "expected": {"points": -72.5, "text": "72.5%"},
     "derivation": "-72.536 rounds to -72.5. The text is the size only; direction goes in the words."},
    {"id": "D03", "check": "percent_display", "value": 0.0725, "expected": {"points": 7.3, "text": "7.3%"},
     "derivation": "The float trap: in floating point 0.0725 x 100 is 7.249999999999999, which rounds to 7.2. Rounding the number as written (Decimal of its repr, x 100 = 7.2500) gives 7.25, and half-up gives 7.3."},
    {"id": "D04", "check": "percent_display", "value": -0.0725, "expected": {"points": -7.3, "text": "7.3%"},
     "derivation": "Half-up means away from zero: -7.25 rounds to -7.3."},
    {"id": "D05", "check": "percent_display", "value": 0.12345, "expected": {"points": 12.3, "text": "12.3%"},
     "derivation": "12.345 to one decimal place: the digit after the first decimal is 4, so 12.3. Rounding happens once; rounding 12.345 to 12.35 first and then to 12.4 would be double rounding."},
    {"id": "D06", "check": "percent_display", "value": -0.0004, "expected": {"points": 0.0, "text": "0.0%"},
     "derivation": "-0.04 rounds to zero. Zero is written 0.0, never -0.0."},
    {"id": "D07", "check": "percent_display", "value": 0.00049, "expected": {"points": 0.0, "text": "0.0%"},
     "derivation": "0.049 rounds to 0.0."},
    {"id": "D08", "check": "percent_display", "value": 419.9278, "expected": {"points": 41992.8, "text": "41,992.8%"},
     "derivation": "Large figures take a thousands comma."},
    {"id": "D09", "check": "percent_display", "value": 0.99995, "expected": {"points": 100.0, "text": "100.0%"},
     "derivation": "99.995 rounds up to 100.0."},
    {"id": "D10", "check": "percent_display", "value": -0.09999999999999998, "expected": {"points": -10.0, "text": "10.0%"},
     "derivation": "A value the engine really produces (1 - 0.9 in floating point): -9.999999999999998 rounds to -10.0."},
    {"id": "D11", "check": "percent_display", "value": 0, "expected": {"points": 0.0, "text": "0.0%"},
     "derivation": "An integer zero is allowed; points is still a float."},
    {"id": "D12", "check": "percent_display", "value": true, "expected_error": "ValueError",
     "derivation": "True is not a number, even though Python treats it as 1."},
    {"id": "D13", "check": "percent_display", "value": null, "expected_error": "ValueError",
     "derivation": "Nothing to display."},
    {"id": "D14", "check": "percent_display", "value": "0.5", "expected_error": "ValueError",
     "derivation": "Text is not a number."},
    {"id": "D15", "check": "pounds_display", "value": 2746.4, "expected": {"rounded": 2750, "text": "£2,750"},
     "derivation": "Nearest £10: 274.64 tens rounds to 275 tens."},
    {"id": "D16", "check": "pounds_display", "value": 2745.0, "expected": {"rounded": 2750, "text": "£2,750"},
     "derivation": "Exactly halfway rounds up."},
    {"id": "D17", "check": "pounds_display", "value": 2744.999, "expected": {"rounded": 2740, "text": "£2,740"},
     "derivation": "Just below halfway rounds down."},
    {"id": "D18", "check": "pounds_display", "value": 4.9, "expected": {"rounded": 0, "text": "£0"},
     "derivation": "Rounds to nothing."},
    {"id": "D19", "check": "pounds_display", "value": 9995.0, "expected": {"rounded": 10000, "text": "£10,000"},
     "derivation": "Halfway rounds up, to £10,000."},
    {"id": "D20", "check": "pounds_display", "value": true, "expected_error": "ValueError",
     "derivation": "True is not a number."},
    {"id": "D21", "check": "months_display", "n": 1, "expected": "1 month",
     "derivation": "Singular."},
    {"id": "D22", "check": "months_display", "n": 14, "expected": "14 months",
     "derivation": "Plural."},
    {"id": "D23", "check": "months_display", "n": 0, "expected": "0 months",
     "derivation": "Zero is plural in English."},
    {"id": "D24", "check": "months_display", "n": 2.0, "expected_error": "ValueError",
     "derivation": "Months are whole numbers given as integers; 2.0 is refused rather than guessed at."},
    {"id": "D25", "check": "months_display", "n": true, "expected_error": "ValueError",
     "derivation": "True is not a number of months."},
    {"id": "D26", "check": "month_name", "month": "2007-09", "expected": "Sep 2007",
     "derivation": "Three-letter English month, then the year."},
    {"id": "D27", "check": "month_name", "month": "2026-12", "expected": "Dec 2026",
     "derivation": "December."},
    {"id": "D28", "check": "month_name", "month": "2026-13", "expected_error": "ValueError",
     "derivation": "Month 13."},

