{
  "file": "cards",
  "spec": "docs/METHODOLOGY.md section 11",
  "authorship": "Expected values and every sentence written by hand by Claude (architect), wording approved by Avi, checked against a separate Claude-only reference implementation, committed by Avi. Codex must never edit this file. If a case fails and you believe the expected value is wrong, stop and report the case ID and your reasoning.",
  "interface": {
    "module": "words.cards",
    "errors": "WordsError (a document is missing something a card needs) is defined in words.cards. Bad arguments to the display helpers raise the built-in ValueError.",
    "percent_display(value)": "Returns {\"points\": float, \"text\": str}. Section 11.2.",
    "pounds_display(value)": "Returns {\"rounded\": int, \"text\": str}. Section 11.2.",
    "months_display(n)": "Returns str. Section 11.2.",
    "month_name(month)": "Returns str, e.g. \"Sep 2007\". Section 11.2.",
    "build_cards(document)": "Returns {\"cards\": [...], \"claims\": [...]}. Sections 11.3 to 11.6."
  },
  "case_fields": {
    "value / n / month": "Passed exactly as given (JSON null is None, true is True).",
    "document / document_edits": "Name of an entry in \"documents\"; edits applied to a deep copy with apply_edits, as in publish.json.",
    "expected": "Compared exactly with assert_result_equal, tolerance 0. Where an expected percent points value is 0.0, the actual value must also have a positive sign (math.copysign(1, value) == 1): -0.0 is wrong.",
    "claim checks": "For every build_cards case with an expected result, also check: claim ids are unique; every claim id a sentence lists appears in that sentence's text as its display, in the order listed; and every claim is listed by at least one sentence."
  },
