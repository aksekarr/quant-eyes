{
  "file": "providers",
  "spec": "docs/METHODOLOGY.md section 9",
  "authorship": "Expected values written by hand by Claude (architect), checked against a separate Claude-only reference implementation, committed by Avi. Codex must never edit this file. If a case fails and you believe the expected value is wrong, stop and report the case ID and your reasoning.",
  "interface": {
    "modules": "pipeline.providers (pure) and pipeline.network (the only module that opens connections).",
    "errors": "ProviderError is defined in pipeline.providers; pipeline.network imports it. Bad arguments raise the built-in ValueError.",
    "PAUSE_SECONDS": "pipeline.providers: {\"tiingo\": 1, \"alphavantage\": 13}.",
    "build_requests(data, key, as_of_month)": "Returns a list of {\"url\": str, \"headers\": dict}, in request order. Section 9.3.",
    "parse_response(data, payload, key)": "Returns a list of [date, value] rows from one parsed response. Section 9.4.",
    "fetch_rows(data, key, as_of_month, http_get, wait)": "Section 9.6. http_get(url, headers) returns parsed JSON or raises ProviderError; wait(seconds) pauses. Returns all rows.",
    "http_get_json(url, headers)": "pipeline.network. Section 9.7. Uses the name urlopen imported into pipeline.network (from urllib.request import Request, urlopen), so tests can replace pipeline.network.urlopen."
  },
  "case_fields": {
    "data": "Name of an entry in \"data\" below; data_edits are applied to a deep copy, as in publish.json.",
    "key / as_of_month": "Passed as given.",
    "payload": "The parsed JSON given to parse_response, exactly as written.",
    "responses": "fetch_rows only: a fake http_get. For each call, look up the url: a value {\"raise\": text} means raise ProviderError(text); anything else is returned as the parsed JSON. A url not listed fails the test. Record every (url, headers) call and every wait(seconds).",
    "expected_calls / expected_waits": "fetch_rows only: the urls called, in order, and the seconds passed to wait, in order. Checked for error cases too.",
    "network": "http_get_json only. Replace pipeline.network.urlopen with a fake that records its arguments and then: \"http_error\" raises urllib.error.HTTPError(url, code, \"x\", {}, None); \"url_error\" raises urllib.error.URLError(ssl.SSLError(\"x\")); \"socket_timeout\" raises socket.timeout(); \"body\" returns a context manager whose read() gives the UTF-8 bytes of body_text.",
    "expected_request": "http_get_json success only: urlopen was called exactly once, with a urllib.request.Request whose full_url equals url and whose headers equal these (compare names case-insensitively: urllib stores Content-Type as Content-type), with timeout=30 and no other keyword arguments (in particular no context)."
  },
  "data": {
    "D_MSFT": {"provider": "tiingo", "kind": "equity", "symbol": "MSFT", "field": "adjClose", "currency": "USD", "basis": "total_return", "start": null},
    "D_BTC": {"provider": "tiingo", "kind": "crypto", "symbol": "btcusd", "field": "close", "currency": "USD", "basis": "total_return", "start": "2014-12"},
    "D_SWDA": {"provider": "alphavantage", "kind": "equity", "symbol": "SWDA.LON", "field": "5. adjusted close", "currency": "GBP", "basis": "total_return", "start": null},
    "D_FX": {"provider": "alphavantage", "kind": "fx", "symbol": "GBP/USD", "field": "4. close", "currency": "USD", "basis": "fx_rate", "start": null}
  },
  "cases": [
    {"id": "Q01", "check": "build_requests", "data": "D_MSFT", "key": "TESTKEY123", "as_of_month": "2026-08",
     "expected": [{"url": "https://api.tiingo.com/tiingo/daily/MSFT/prices?startDate=1990-01-01", "headers": {"Authorization": "Token TESTKEY123", "Content-Type": "application/json"}}],
     "derivation": "Tiingo daily prices, full history, no resample. The key goes in the Authorization header, never the URL."},
    {"id": "Q02", "check": "build_requests", "data": "D_BTC", "key": "TESTKEY123", "as_of_month": "2016-02",
     "expected": [
       {"url": "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2014-01-01&endDate=2014-12-31&resampleFreq=1day", "headers": {"Authorization": "Token TESTKEY123", "Content-Type": "application/json"}},
       {"url": "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2015-01-01&endDate=2015-12-31&resampleFreq=1day", "headers": {"Authorization": "Token TESTKEY123", "Content-Type": "application/json"}},
       {"url": "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2016-01-01&endDate=2016-12-31&resampleFreq=1day", "headers": {"Authorization": "Token TESTKEY123", "Content-Type": "application/json"}}],
     "derivation": "One request per calendar year from the start month's year (2014) to the as-of month's year (2016): 3 requests, fence posts included at both ends."},
    {"id": "Q03", "check": "build_requests", "data": "D_SWDA", "key": "TESTKEY123", "as_of_month": "2026-08",
     "expected": [{"url": "https://www.alphavantage.co/query?function=TIME_SERIES_MONTHLY_ADJUSTED&symbol=SWDA.LON&apikey=TESTKEY123", "headers": {}}],
     "derivation": "Alpha Vantage takes the key in the URL, last. That is why no URL may ever be printed."},
    {"id": "Q04", "check": "build_requests", "data": "D_FX", "key": "TESTKEY123", "as_of_month": "2026-08",
     "expected": [{"url": "https://www.alphavantage.co/query?function=FX_MONTHLY&from_symbol=GBP&to_symbol=USD&apikey=TESTKEY123", "headers": {}}],
     "derivation": "GBP/USD splits into from GBP, to USD: dollars per pound (section 2.1)."},
    {"id": "Q05", "check": "build_requests", "data": "D_SWDA", "key": "TEST&KEY", "as_of_month": "2026-08", "expected_error": "ValueError", "message_must_not_contain": ["TEST&KEY", "TEST"],
     "derivation": "A key must be letters and digits only; '&' would break into the URL. The message never shows the key."},
    {"id": "Q06", "check": "build_requests", "data": "D_MSFT", "key": "", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "No key."},
    {"id": "Q07", "check": "build_requests", "data": "D_MSFT", "data_edits": [{"path": ["symbol"], "set": "MS FT"}], "key": "TESTKEY123", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "An equity or crypto symbol is letters, digits and dots only."},
    {"id": "Q08", "check": "build_requests", "data": "D_FX", "data_edits": [{"path": ["symbol"], "set": "GBPUSD"}], "key": "TESTKEY123", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "An exchange-rate symbol is three capitals, a slash, three capitals."},
    {"id": "Q09", "check": "build_requests", "data": "D_BTC", "data_edits": [{"path": ["start"], "set": null}], "key": "TESTKEY123", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "Crypto is fetched year by year from its start, so it must have one."},
    {"id": "Q10", "check": "build_requests", "data": "D_BTC", "data_edits": [{"path": ["start"], "set": "2027-01"}], "key": "TESTKEY123", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "Start after the as-of month: nothing to fetch."},
    {"id": "Q11", "check": "build_requests", "data": "D_MSFT", "key": "TESTKEY123", "as_of_month": "2026-8", "expected_error": "ValueError",
     "derivation": "Not YYYY-MM."},
    {"id": "Q12", "check": "build_requests", "data": "D_MSFT", "data_edits": [{"path": ["kind"], "set": "fx"}], "key": "TESTKEY123", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "Tiingo is used for equity and crypto only; there is no Tiingo fx request."},
    {"id": "Q13", "check": "build_requests", "data": "D_SWDA", "data_edits": [{"path": ["kind"], "set": "crypto"}], "key": "TESTKEY123", "as_of_month": "2026-08", "expected_error": "ValueError",
     "derivation": "Alpha Vantage is used for equity and fx only."},

    {"id": "S01", "check": "parse_response", "data": "D_MSFT", "key": "TESTKEY123",
     "payload": [{"date": "2020-01-31T00:00:00.000Z", "close": 170.1, "adjClose": 101.5}, {"date": "2020-02-28T00:00:00.000Z", "close": 162.0, "adjClose": 103}],
     "expected": [["2020-01-31T00:00:00.000Z", 101.5], ["2020-02-28T00:00:00.000Z", 103]],
     "derivation": "Date and the named field (adjClose), unchanged. Close is ignored."},
    {"id": "S02", "check": "parse_response", "data": "D_MSFT", "key": "TESTKEY123",
     "payload": [{"date": "2020-01-31T00:00:00.000Z", "close": 170.1}],
     "expected": [["2020-01-31T00:00:00.000Z", null]],
     "derivation": "adjClose missing: the value is empty, never close in its place. The month-end picker then fails closed if this is a month-end row."},
    {"id": "S03", "check": "parse_response", "data": "D_MSFT", "key": "TESTKEY123",
     "payload": {"detail": "Error: Ticker 'MSFT' not found"},
     "expected_error": "ProviderError", "message_must_contain": ["not found"],
     "derivation": "An object instead of a list is a Tiingo message. Its detail text is shown, cleaned (9.5)."},
    {"id": "S04", "check": "parse_response", "data": "D_MSFT", "key": "TESTKEY123", "payload": "oops",
     "expected_error": "ProviderError",
     "derivation": "Neither a list nor an object."},
    {"id": "S05", "check": "parse_response", "data": "D_BTC", "key": "TESTKEY123",
     "payload": [{"ticker": "btcusd", "baseCurrency": "btc", "quoteCurrency": "usd", "priceData": [{"date": "2015-01-30T00:00:00+00:00", "close": 39}, {"date": "2015-01-31T00:00:00+00:00", "close": 40}]}],
     "expected": [["2015-01-30T00:00:00+00:00", 39], ["2015-01-31T00:00:00+00:00", 40]],
     "derivation": "Crypto: one object for the one ticker asked for; rows from its priceData, named field close."},
    {"id": "S06", "check": "parse_response", "data": "D_BTC", "key": "TESTKEY123", "payload": [],
     "expected": [],
     "derivation": "An empty list: no data for that year. No rows, not an error; coverage is judged later (section 7)."},
    {"id": "S07", "check": "parse_response", "data": "D_BTC", "key": "TESTKEY123",
     "payload": [{"ticker": "ethusd", "priceData": [{"date": "2015-01-31T00:00:00+00:00", "close": 40}]}],
     "expected_error": "ProviderError", "message_must_contain": ["ticker"],
     "derivation": "The response is for a different ticker: the wrong instrument's prices."},
    {"id": "S08", "check": "parse_response", "data": "D_BTC", "key": "TESTKEY123",
     "payload": [{"ticker": "btcusd", "priceData": []}, {"ticker": "btcusd", "priceData": []}],
     "expected_error": "ProviderError",
     "derivation": "One ticker was asked for; two objects came back."},
    {"id": "S09", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {"2. Symbol": "SWDA.LON"}, "Monthly Adjusted Time Series": {"2020-03-31": {"4. close": "104.0000", "5. adjusted close": "105.2500", "7. dividend amount": "0.0000"}, "2020-02-28": {"4. close": "102.0000", "5. adjusted close": "103.0000", "7. dividend amount": "0.0000"}}},
     "expected": [["2020-03-31", "105.2500"], ["2020-02-28", "103.0000"]],
     "derivation": "Apart from Meta Data there is exactly one key; its entries give date and the named field (5. adjusted close), text unchanged, in the order given (newest first)."},
    {"id": "S10", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {}, "Time Series (Monthly Adjusted)": {"2020-03-31": {"5. adjusted close": "105.2500"}}},
     "expected": [["2020-03-31", "105.2500"]],
     "derivation": "Same rule under the other name the docs use. The series key's name is not relied on."},
    {"id": "S11", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {}, "Monthly Adjusted Time Series": {"2020-03-31": {"4. close": "104.0000"}}},
     "expected": [["2020-03-31", null]],
     "derivation": "Adjusted close missing: empty, never 4. close in its place. Substituting close would silently turn a total-return series into price only."},
    {"id": "S12", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Note": "Thank you for using Alpha Vantage! Our standard API rate limit is 25 requests per day. Your key TESTKEY123 has hit it."},
     "expected_error": "ProviderError", "message_must_contain": ["rate limit", "[key]"], "message_must_not_contain": ["TESTKEY123"],
     "derivation": "Alpha Vantage reports problems in the body. The text is shown, with the key replaced by [key]."},
    {"id": "S13", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Information": "This is a premium endpoint. See https://www.alphavantage.co/query?function=X&apikey=abc999XYZ for details."},
     "expected_error": "ProviderError", "message_must_contain": ["premium", "apikey=[key]"], "message_must_not_contain": ["abc999XYZ"],
     "derivation": "Any apikey= value in provider text is replaced, even one that isn't our key."},
    {"id": "S14", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Error Message": "Invalid API call."},
     "expected_error": "ProviderError", "message_must_contain": ["Invalid API call"],
     "derivation": "The third message field."},
    {"id": "S15", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Information": "Start of a long provider message. ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ABCDEFGHIJ ENDMARKER"},
     "expected_error": "ProviderError", "message_must_contain": ["Start of a long"], "message_must_not_contain": ["ENDMARKER"],
     "derivation": "Provider text is cut to 200 characters. ENDMARKER begins at character 233."},
    {"id": "S16", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {}, "Monthly Adjusted Time Series": {}, "Weekly Adjusted Time Series": {}},
     "expected_error": "ProviderError",
     "derivation": "Two candidate series: ambiguous, so refused rather than guessed."},
    {"id": "S17", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {}},
     "expected_error": "ProviderError",
     "derivation": "No series at all."},
    {"id": "S18", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {}, "Monthly Adjusted Time Series": [["2020-03-31", "105.2500"]]},
     "expected_error": "ProviderError",
     "derivation": "The series must be an object of date to entry."},
    {"id": "S19", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": [{"date": "2020-03-31"}],
     "expected_error": "ProviderError",
     "derivation": "Alpha Vantage always answers with an object."},
    {"id": "S20", "check": "parse_response", "data": "D_FX", "key": "TESTKEY123",
     "payload": {"Meta Data": {}, "Time Series FX (Monthly)": {"2020-02-28": {"1. open": "1.3000", "4. close": "1.2500"}}},
     "expected": [["2020-02-28", "1.2500"]],
     "derivation": "The exchange rate: same structure, field 4. close."},
    {"id": "S21", "check": "parse_response", "data": "D_SWDA", "key": "TESTKEY123",
     "payload": {"Meta Data": {}, "Monthly Adjusted Time Series": {"2020-03-31": "105.2500"}},
     "expected": [["2020-03-31", null]],
     "derivation": "An entry that isn't an object has no named field: empty value, and the picker decides."},
    {"id": "S22", "check": "parse_response", "data": "D_MSFT", "key": "TESTKEY123",
     "payload": {"detail": "Invalid token TESTKEY123 supplied"},
     "expected_error": "ProviderError", "message_must_contain": ["Invalid token", "[key]"], "message_must_not_contain": ["TESTKEY123"],
     "derivation": "Tiingo text is cleaned too."},

    {"id": "G01", "check": "fetch_rows", "data": "D_BTC", "key": "TESTKEY123", "as_of_month": "2016-02",
     "responses": {
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2014-01-01&endDate=2014-12-31&resampleFreq=1day": [{"ticker": "btcusd", "priceData": [{"date": "2014-12-31T00:00:00+00:00", "close": 50}]}],
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2015-01-01&endDate=2015-12-31&resampleFreq=1day": [{"ticker": "btcusd", "priceData": [{"date": "2015-01-31T00:00:00+00:00", "close": 40}, {"date": "2015-12-31T00:00:00+00:00", "close": 42}]}],
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2016-01-01&endDate=2016-12-31&resampleFreq=1day": [{"ticker": "btcusd", "priceData": [{"date": "2016-01-31T00:00:00+00:00", "close": 44}]}]},
     "expected": [["2014-12-31T00:00:00+00:00", 50], ["2015-01-31T00:00:00+00:00", 40], ["2015-12-31T00:00:00+00:00", 42], ["2016-01-31T00:00:00+00:00", 44]],
     "expected_calls": [
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2014-01-01&endDate=2014-12-31&resampleFreq=1day",
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2015-01-01&endDate=2015-12-31&resampleFreq=1day",
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2016-01-01&endDate=2016-12-31&resampleFreq=1day"],
     "expected_waits": [1, 1, 1],
     "derivation": "Three requests in order, a 1-second pause before each, rows joined in request order."},
    {"id": "G02", "check": "fetch_rows", "data": "D_SWDA", "key": "TESTKEY123", "as_of_month": "2026-08",
     "responses": {"https://www.alphavantage.co/query?function=TIME_SERIES_MONTHLY_ADJUSTED&symbol=SWDA.LON&apikey=TESTKEY123": {"Meta Data": {}, "Monthly Adjusted Time Series": {"2026-08-28": {"5. adjusted close": "110.0000"}}}},
     "expected": [["2026-08-28", "110.0000"]],
     "expected_calls": ["https://www.alphavantage.co/query?function=TIME_SERIES_MONTHLY_ADJUSTED&symbol=SWDA.LON&apikey=TESTKEY123"],
     "expected_waits": [13],
     "derivation": "Alpha Vantage: a 13-second pause before the request, for its per-minute limit."},
    {"id": "G03", "check": "fetch_rows", "data": "D_SWDA", "key": "TESTKEY123", "as_of_month": "2026-08",
     "responses": {"https://www.alphavantage.co/query?function=TIME_SERIES_MONTHLY_ADJUSTED&symbol=SWDA.LON&apikey=TESTKEY123": {"raise": "HTTP 429 for TESTKEY123"}},
     "expected_error": "ProviderError", "message_must_contain": ["alphavantage", "SWDA.LON", "HTTP 429", "[key]"], "message_must_not_contain": ["TESTKEY123"],
     "expected_calls": ["https://www.alphavantage.co/query?function=TIME_SERIES_MONTHLY_ADJUSTED&symbol=SWDA.LON&apikey=TESTKEY123"],
     "expected_waits": [13],
     "derivation": "A connection error is re-raised naming provider and symbol, and cleaned again: even if the error text somehow held the key, it doesn't leave."},
    {"id": "G04", "check": "fetch_rows", "data": "D_BTC", "key": "TESTKEY123", "as_of_month": "2016-02",
     "responses": {
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2014-01-01&endDate=2014-12-31&resampleFreq=1day": [{"ticker": "btcusd", "priceData": []}],
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2015-01-01&endDate=2015-12-31&resampleFreq=1day": {"detail": "Too many requests"}},
     "expected_error": "ProviderError", "message_must_contain": ["tiingo", "btcusd", "Too many requests"],
     "expected_calls": [
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2014-01-01&endDate=2014-12-31&resampleFreq=1day",
       "https://api.tiingo.com/tiingo/crypto/prices?tickers=btcusd&startDate=2015-01-01&endDate=2015-12-31&resampleFreq=1day"],
     "expected_waits": [1, 1],
     "derivation": "The second year fails, so the third is never requested."},
    {"id": "G05", "check": "fetch_rows", "data": "D_MSFT", "key": "", "as_of_month": "2026-08",
     "responses": {},
     "expected_error": "ValueError", "expected_calls": [], "expected_waits": [],
     "derivation": "A bad key is refused before anything is requested or waited for."},

    {"id": "N01", "check": "http_get_json", "network": "http_error", "code": 429,
     "url": "https://www.alphavantage.co/query?function=FX_MONTHLY&from_symbol=GBP&to_symbol=USD&apikey=TESTKEY123", "headers": {},
     "expected_error": "ProviderError", "message_must_contain": ["HTTP 429"], "message_must_not_contain": ["TESTKEY123", "alphavantage.co"],
     "derivation": "The status code only; the URL (which holds the key) never appears."},
    {"id": "N02", "check": "http_get_json", "network": "url_error",
     "url": "https://www.alphavantage.co/query?function=FX_MONTHLY&from_symbol=GBP&to_symbol=USD&apikey=TESTKEY123", "headers": {},
     "expected_error": "ProviderError", "message_must_contain": ["connection problem", "SSLError"], "message_must_not_contain": ["TESTKEY123"],
     "derivation": "A connection failure (here a certificate problem) is named by its error type. Verification is never switched off to make it work."},
    {"id": "N03", "check": "http_get_json", "network": "socket_timeout",
     "url": "https://api.tiingo.com/tiingo/daily/MSFT/prices?startDate=1990-01-01", "headers": {"Authorization": "Token TESTKEY123"},
     "expected_error": "ProviderError", "message_must_contain": ["timed out"], "message_must_not_contain": ["TESTKEY123"],
     "derivation": "On Python 3.9 a read timeout is socket.timeout, which is not TimeoutError (they merged in 3.10). Both must be caught."},
    {"id": "N04", "check": "http_get_json", "network": "body", "body_text": "<html>Service unavailable</html>",
     "url": "https://api.tiingo.com/tiingo/daily/MSFT/prices?startDate=1990-01-01", "headers": {"Authorization": "Token TESTKEY123"},
     "expected_error": "ProviderError", "message_must_contain": ["not JSON"], "message_must_not_contain": ["Service unavailable"],
     "derivation": "A body that isn't JSON is refused without echoing it: a body may hold prices."},
    {"id": "N05", "check": "http_get_json", "network": "body", "body_text": "{\"a\": [1, 2]}",
     "url": "https://api.tiingo.com/tiingo/daily/MSFT/prices?startDate=1990-01-01", "headers": {"Authorization": "Token TESTKEY123", "Content-Type": "application/json"},
     "expected": {"a": [1, 2]},
     "expected_request": {"url": "https://api.tiingo.com/tiingo/daily/MSFT/prices?startDate=1990-01-01", "headers": {"Authorization": "Token TESTKEY123", "Content-Type": "application/json"}},
     "derivation": "Success: one GET with the given headers, a 30-second timeout, and Python's default certificate checking (no context argument)."}
  ]
}
