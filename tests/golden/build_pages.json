    {"id": "W22", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "document_edits": {"gbf": [{"path": ["generated_on"], "delete": true}]}, "page_failure": {"call": 1, "raise": "RuntimeError", "message": "boom"}, "expected_error": "PageError", "message_equals": "usa: page: RuntimeError", "expected_files": [], "derivation": "Order (step 5): usa is finished, page included, before gbf's document is checked."},
