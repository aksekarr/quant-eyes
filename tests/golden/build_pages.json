  "cases": [
    {"id": "W01", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "expected_summary": {"data_as_of": "2026-08", "generated_on": "2026-09-29", "method_version": "1.0", "headlines": [], "headlines_as_of": "2026-08", "written": ["usa.json", "gbf.json", "index.json"]}, "derivation": "An empty output folder: one page per asset plus the index, written in the site format (sort_keys, indent 2, ensure_ascii off so the pound sign and minus sign stay readable). The summary lists the files in rename order: pages in list order, index.json last."},
    {"id": "W02", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"usa.json": "old\n", "index.json": "old\n", ".DS_Store": "finder"}, "expected_files": [".DS_Store", "gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "expected_summary": {"data_as_of": "2026-08", "generated_on": "2026-09-29", "method_version": "1.0", "headlines": [], "headlines_as_of": "2026-08", "written": ["usa.json", "gbf.json", "index.json"]}, "derivation": "Last run's page and index are replaced; names starting with a dot are left alone."},
    {"id": "W03", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"old.json": "x"}, "expected_error": "PageError", "message_equals": "output folder: unexpected old.json", "expected_files": ["old.json"], "derivation": "A page for an instrument no longer in the list would go on being published. Nothing is written."},
    {"id": "W04", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"index.json.tmp": "x"}, "expected_error": "PageError", "message_equals": "output folder: unexpected index.json.tmp", "expected_files": ["index.json.tmp"], "derivation": "A leftover temporary file from an interrupted run."},
    {"id": "W05", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"trk.json": "x"}, "expected_error": "PageError", "message_equals": "output folder: unexpected trk.json", "expected_files": ["trk.json"], "derivation": "The benchmark has no page of its own."},
    {"id": "W06", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"sub": {"folder": true}}, "expected_error": "PageError", "message_equals": "output folder: unexpected sub", "expected_files": ["sub"], "derivation": "A subfolder is unexpected."},
    {"id": "W07", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"zz.json": "x", "gbf.json.tmp": "x"}, "expected_error": "PageError", "message_equals": "output folder: unexpected gbf.json.tmp", "expected_files": ["gbf.json.tmp", "zz.json"], "derivation": "Two unexpected names: the first in alphabetical order is named."},
    {"id": "W08", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "out_dir_missing": true, "expected_error": "PageError", "message_equals": "output folder: does not exist", "expected_files": null, "derivation": "write_pages never creates the folder; the command does."},
