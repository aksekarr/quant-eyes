    {"id": "W26", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"usa.json": {"folder": true}}, "expected_error": "PageError", "message_equals": "output folder: unexpected usa.json", "expected_files": ["usa.json"], "derivation": "Only files may have the allowed names: a folder called usa.json is unexpected."},
