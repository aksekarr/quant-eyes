    {"id": "B13", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "STALE", "expected_exit": 0, "expected_stdout": ["Data as of 2026-08, generated on 2026-09-29, method 1.0.", "Headlines: none, because words/headlines.json is for 2026-07; draft and review headlines for 2026-08.", "Wrote 3 files to site/data."], "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "derivation": "After a data refresh the pages are written without headlines, and the command says why and what to do."},
    {"id": "B14", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "BOTH", "expected_exit": 0, "expected_stdout": ["Data as of 2026-08, generated on 2026-09-29, method 1.0.", "Headlines: 2 of 2 pages have an approved headline.", "Wrote 3 files to site/data."], "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "derivation": "Both approved headlines published."},
