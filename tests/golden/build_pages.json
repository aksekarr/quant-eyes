    {"id": "W32", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "BOTH", "approvals_edits": [{"path": ["note"], "set": "x"}], "expected_error": "PageError", "message_must_contain": ["headlines: check: WordsError"], "expected_files": [], "derivation": "The approvals file's shape is checked (section 15.2)."},
    {"id": "W33", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "BOTH", "approvals_edits": [{"path": ["headlines", "usa", "text"], "set": "£10,000 invested in US share at its high in Sep 2007 was worth £2,750 at its low in Nov 2008, and it later recovered."}], "page_failure": {"call": 1, "raise": "RuntimeError", "message": "boom"}, "expected_error": "PageError", "message_equals": "usa: page: RuntimeError", "expected_files": [], "derivation": "Order: every page is built (step 5) before the headlines are checked (step 6)."},
    {"id": "W34", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "BOTH", "approvals_edits": [{"path": ["headlines", "usa", "text"], "set": "£10,000 invested in US share at its high in Sep 2007 was worth £2,750 at its low in Nov 2008, and it later recovered."}], "document_edits": {"gbf": [{"path": ["generated_on"], "set": "2026-09-30"}]}, "expected_error": "PageError", "message_equals": "headlines: check: WordsError: usa headline failed: currency.", "expected_files": [], "derivation": "Order: the headlines (step 6) are checked before the index (step 7), which would fail on the two generation dates."},
    {"id": "B01", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "expected_exit": 0, "expected_stdout": ["Data as of 2026-08, generated on 2026-09-29, method 1.0.", "Headlines: 0 of 2 pages have an approved headline.", "Wrote 3 files to site/data."], "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "derivation": "A first run: site/data is created and filled."},
    {"id": "B02", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"usa.json": "old\n", ".DS_Store": "finder"}, "expected_exit": 0, "expected_stdout": ["Data as of 2026-08, generated on 2026-09-29, method 1.0.", "Headlines: 0 of 2 pages have an approved headline.", "Wrote 3 files to site/data."], "expected_files": [".DS_Store", "gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "derivation": "A later run replaces last run's files."},
    {"id": "B03", "check": "cli", "argv": ["--list"], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "expected_exit": 2, "expected_stdout": ["Usage: python3 scripts/build_pages.py"], "expected_files": null, "derivation": "No arguments are accepted."},
    {"id": "B04", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "registry_text": "{ not json", "expected_exit": 1, "expected_stdout": ["FAILED: registry: load: JSONDecodeError", "Nothing was written."], "expected_files": null, "derivation": "An unreadable instrument list: the error type only."},
    {"id": "B05", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "registry_edits": [{"path": ["instruments", 1, "identity", "quote_unit"], "set": "pence"}], "expected_exit": 1, "expected_stdout": ["FAILED: registry: check: RegistryError: instrument usa identity quote_unit does not match trading_currency.", "Nothing was written."], "expected_files": null, "derivation": "The command checks the list before using it to find the files (message text from section 8.1's check)."},
    {"id": "B06", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA"}, "context_missing": true, "expected_exit": 1, "expected_stdout": ["FAILED: context: load: FileNotFoundError", "Nothing was written."], "expected_files": null, "derivation": "No facts file, and gbf's published file is missing too: the facts file is loaded first."},
    {"id": "B07", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA"}, "expected_exit": 1, "expected_stdout": ["FAILED: gbf: load: FileNotFoundError", "Nothing was written."], "expected_files": null, "derivation": "An asset's published file is missing; usa loaded first, in list order."},
    {"id": "B08", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "before_files": {"old.json": "x"}, "expected_exit": 1, "expected_stdout": ["FAILED: output folder: unexpected old.json", "Check git status --short before committing anything."], "expected_files": ["old.json"], "derivation": "A PageError from write_pages is printed as it is."},
    {"id": "B09", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "write_pages_raises": "boom 12.3456 TESTKEY123", "expected_exit": 1, "expected_stdout": ["FAILED: unexpected RuntimeError.", "Check git status --short before committing anything."], "message_must_not_contain": ["12.3456", "TESTKEY123"], "expected_files": [], "derivation": "Any other error: its type only. site/data was already created, and is empty."},
    {"id": "B10", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "registry_edits": [{"path": ["instruments", 1, "identity", "quote_unit"], "set": "pence"}], "context_missing": true, "expected_exit": 1, "expected_stdout": ["FAILED: registry: check: RegistryError: instrument usa identity quote_unit does not match trading_currency.", "Nothing was written."], "expected_files": null, "derivation": "Order: the list is checked before the facts file is loaded."},
    {"id": "B11", "check": "cli", "argv": [], "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "headlines_missing": true, "expected_exit": 1, "expected_stdout": ["FAILED: headlines: load: FileNotFoundError", "Nothing was written."], "expected_files": null, "derivation": "The approvals file is required (an empty one is {\"data_as_of\": ..., \"headlines\": {}}): a missing file is a mistake, not an absence of headlines."},
