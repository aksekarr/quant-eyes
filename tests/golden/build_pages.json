    {"id": "W24", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "index_read_back_mismatch": true, "before_files": {"usa.json": "old\n", "index.json": "old\n"}, "expected_error": "PageError", "message_equals": "index.json: write: read back differently", "expected_files": ["index.json", "usa.json"], "derivation": "The pages read back correctly but the index doesn't (a tuple is written as a list): every temporary file is removed and last run's files are untouched."},
