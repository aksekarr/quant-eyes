    {"id": "W18", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "document_edits": {"gbf": [{"path": ["generated_on"], "delete": true}]}, "before_files": {"usa.json": "old\n", "index.json": "old\n"}, "expected_error": "PageError", "message_must_contain": ["gbf: check: PublishError", "generated_on"], "expected_files": ["index.json", "usa.json"], "derivation": "Each document is checked again (section 8.3) before its page is built."},
    {"id": "W19", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_USA"}, "before_files": {"usa.json": "old\n", "index.json": "old\n"}, "expected_error": "PageError", "message_equals": "gbf: document: for usa", "expected_files": ["index.json", "usa.json"], "derivation": "A valid document filed under the wrong asset: gbf.json would otherwise show usa's page."},
