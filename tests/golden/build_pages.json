    {"id": "W28", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "BOTH", "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "expected_summary": {"data_as_of": "2026-08", "generated_on": "2026-09-29", "method_version": "1.0", "headlines": ["usa", "gbf"], "headlines_as_of": "2026-08", "written": ["usa.json", "gbf.json", "index.json"]}, "derivation": "Section 15.4: each page carries its approved headline (text, claims, drafted_by, reviewed_on). The summary lists them in the instrument list's order, though the file lists gbf first."},
    {"id": "W29", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "GBF_ONLY", "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "expected_summary": {"data_as_of": "2026-08", "generated_on": "2026-09-29", "method_version": "1.0", "headlines": ["gbf"], "headlines_as_of": "2026-08", "written": ["usa.json", "gbf.json", "index.json"]}, "derivation": "An asset with no approved headline gets none (its headline stays null)."},
    {"id": "W30", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "approvals": "STALE", "expected_files": ["gbf.json", "index.json", "usa.json"], "expected_pages": ["gbf.json", "index.json", "usa.json"], "expected_summary": {"data_as_of": "2026-08", "generated_on": "2026-09-29", "method_version": "1.0", "headlines": [], "headlines_as_of": "2026-07", "written": ["usa.json", "gbf.json", "index.json"]}, "derivation": "Last month's approvals: every page is written without a headline (section 15.2 drops them), never with old words against new numbers. headlines_as_of says which month the file is for."},
