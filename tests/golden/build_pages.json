    {"id": "W11", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "registry_edits": [{"path": ["instruments", 1, "identity", "quote_unit"], "set": "pence"}], "context_edits": [{"path": ["instruments", "usa", "priced_in_pounds_holds_dollars"], "set": true}], "expected_error": "PageError", "message_must_contain": ["registry: check: RegistryError"], "message_must_not_contain": ["context"], "expected_files": [], "derivation": "Order: the instrument list before the facts file."},
    {"id": "W12", "check": "write", "documents": {"usa": "DOC_USA", "gbf": "DOC_GBF"}, "context_edits": [{"path": ["instruments", "usa", "priced_in_pounds_holds_dollars"], "set": true}], "before_files": {"old.json": "x"}, "expected_error": "PageError", "message_must_contain": ["context: check: WordsError"], "message_must_not_contain": ["old.json"], "expected_files": ["old.json"], "derivation": "Order: the facts file before the output folder."},
    {"id": "W13", "check": "write", "documents": {"usa": "DOC_USA"}, "before_files": {"old.json": "x"}, "expected_error": "PageError", "message_equals": "output folder: unexpected old.json", "expected_files": ["old.json"], "derivation": "Order: the output folder before the documents."},
    {"id": "W14", "check": "write", "documents": {"usa": "DOC_USA"}, "before_files": {"usa.json": "old\n", "index.json": "old\n"}, "expected_error": "PageError", "message_equals": "gbf: document: missing", "expected_files": ["index.json", "usa.json"], "derivation": "Every asset in the list needs its published file."},
